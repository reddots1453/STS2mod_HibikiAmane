<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the installed SDK parser; no game execution or downloaded compiler package. -->
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
    <Compile Include="../../src/Core/Cards/HumilityEffectProgram.cs" Link="Production/HumilityEffectProgram.cs" />
    <Compile Include="../../src/Core/Cards/HumilityExtractedCatalog.cs" Link="Production/HumilityExtractedCatalog.cs" />
  </ItemGroup>
</Project>
